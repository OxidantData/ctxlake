/target
**/*.rs.bk
Cargo.lock.bak
.DS_Store

# docs site
node_modules
site/.vitepress/cache
site/.vitepress/dist

# local runtime state — never commit a spool, it contains transcripts
.ctxlake/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# agent worktrees and session scratch — never part of the repo
.claude/

# Python bytecode from running docs/checks/ locally.
__pycache__/
*.pyc
