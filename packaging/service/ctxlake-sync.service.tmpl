# systemd user unit for the ctxlake sync daemon.
#
# Rendered by `ctxlake sync install` into ~/.config/systemd/user/ctxlake-sync.service.
# Placeholders: {{EXEC}} {{CONFIG}} {{HOME}} {{PATH}}
#
# A USER unit, not a system one: the daemon reads this user's spool and writes with
# this user's store credentials. A system unit would run as root and reach neither.
#
# Reboot survival needs `loginctl enable-linger <user>`. Without it a user manager
# stops at logout, so on a headless host the service would silently not come back —
# `ctxlake sync install` checks lingering and says so rather than leaving you to find
# out after a reboot.

[Unit]
Description=ctxlake sync — ships the local spool to the lake and refreshes the cache
Documentation=https://ctxlake.oxidantdata.com/reference.html
After=network-online.target
Wants=network-online.target
# The daemon backs off on its own; systemd's start limiter would fight that and give
# up permanently after a handful of restarts during, say, a long network outage.
StartLimitIntervalSec=0

[Service]
Type=simple
# --config is passed explicitly because a unit does not inherit the shell's idea of
# where ctxlake.toml lives, and --foreground because systemd owns supervision: the
# daemon must not fork away from the process systemd is watching.
ExecStart="{{EXEC}}" --config "{{CONFIG}}" sync run --foreground
WorkingDirectory={{HOME}}
# Pinned, not inherited. Every local path ctxlake uses — the spool the hook writes,
# the cache the briefing is read from, the pidfile — hangs off $HOME, so a daemon
# that resolves a different one than the installing shell did silently drains a
# spool nobody is filling. systemd already sets this correctly for a user unit;
# recording it here is what makes the unit say which home it was installed for.
Environment="HOME={{HOME}}"
# Pinned for the same reason, and for a failure that is much harder to see. A systemd
# user unit gets a minimal PATH that contains none of the directories a person
# installs tools into, so `[summarize.batch] provider = "claude-cli"` (or "ollama",
# or anything else that shells out) passes `ctxlake doctor` in your shell and then
# cannot find the binary here. This is the PATH `ctxlake sync install` itself ran
# with, so the check and the daemon resolve the same binary — which is the only thing
# that makes a green pre-install check mean anything.
Environment="PATH={{PATH}}"

# on-failure, not always: `ctxlake sync stop` exits 0 and must stay stopped.
Restart=on-failure
RestartSec=5
# 78 is EX_CONFIG — a missing or invalid ctxlake.toml. Restarting cannot fix that, and
# a restart loop would bury the real error in the journal. `ctxlake` exits 78 for
# exactly this case; crates/ctxlake-cli/src/main.rs has the matching constant.
RestartPreventExitStatus=78

KillMode=mixed
KillSignal=SIGTERM
# The daemon flushes its spool and clears its presence entry on SIGTERM. Cutting it
# short costs the flush, so give it room.
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
